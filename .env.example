# ==================== AI Video Workflow Studio ====================
# 前端环境变量（VITE_ 前缀）

# ── 主渠道 API（yunwu.ai — LLM + 图片）──
VITE_API_BASE_URL=https://yunwu.ai
VITE_API_KEY=your-api-key-here

# ── 视频渠道路由优先级（逗号分隔，越前优先级越高）──
VITE_VIDEO_CHANNEL_PRIORITY=puyo,apimart

# ── Puyo 视频渠道 ──
VITE_PUYO_API_KEY=your-puyo-key-here
VITE_PUYO_API_URL=https://api.puyo.ai

# ── APIMart 视频渠道 ──
VITE_APIMART_API_KEY=your-apimart-key-here
VITE_APIMART_API_URL=https://api.apimart.ai

# ── 默认模型 ──
VITE_DEFAULT_VIDEO_MODEL=doubao-seedance-2-0
VITE_DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image-preview
VITE_DEFAULT_LLM_MODEL=gemini-3.1-pro-preview

# ── 默认生成参数 ──
VITE_DEFAULT_VIDEO_DURATION=8
VITE_DEFAULT_ASPECT_RATIO=16:9
VITE_DEFAULT_IMAGE_SIZE=2k
VITE_DEFAULT_IMAGE_ASPECT_RATIO=16:9

# ── 任务配置 ──
VITE_POLL_INTERVAL=5000
VITE_TASK_MAX_CONCURRENT=1
VITE_TASK_MAX_RETRIES=3
VITE_TASK_RETRY_DELAYS=3000,8000,15000

# ── Agent 配置 ──
VITE_AGENT_MAX_TOOL_ROUNDS=25
VITE_AGENT_TEMPERATURE=0.3
VITE_AGENT_MAX_TOKENS=4096
VITE_CONTEXT_COMPACTION_WINDOW=10
VITE_AGENT_REFLECTION_THRESHOLD=3

# ── COS 上传 ──
VITE_COS_SECRET_ID=your-cos-secret-id
VITE_COS_SECRET_KEY=your-cos-secret-key
VITE_COS_REGION=ap-guangzhou
VITE_COS_BUCKET=your-bucket-name

# ── 后端 API（启用后端模式时）──
VITE_BACKEND_ENABLED=false
VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000/ws

# ==================== 后端环境变量（server/.env）====================
# 以下变量配置在 server/.env 中，此处仅作参考

# ── MySQL 数据库 ──
# DB_HOST=43.160.252.172
# DB_PORT=13306
# DB_USER=root
# DB_PASSWORD=your-db-password
# DB_NAME=prism_ai

# ── Redis ──
# REDIS_HOST=43.160.252.172
# REDIS_PORT=16379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=6

# ── LLM API ──
# LLM_BASE_URL=https://yunwu.ai
# LLM_API_KEY=your-api-key-here

# ── COS ──
# COS_SECRET_ID=your-cos-secret-id
# COS_SECRET_KEY=your-cos-secret-key
# COS_REGION=ap-guangzhou
# COS_BUCKET=your-bucket-name
