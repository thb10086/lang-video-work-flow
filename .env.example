# ═══════════════════════════════════════════════════════════
# AI Video Workflow Studio — 前端环境配置
# 修改后需重启开发服务器 (npm run dev)
#
# 注意：所有密钥（API Key / COS / 渠道 Key）已迁移到 server/.env
# 前端仅保留后端地址和 UI 偏好设置，零密钥暴露。
# ═══════════════════════════════════════════════════════════

# ════════════════════════════════════════
# 后端地址（必填）
# ════════════════════════════════════════
VITE_BACKEND_URL=http://localhost:8000

# ════════════════════════════════════════
# Agent 行为配置
# ════════════════════════════════════════
VITE_AGENT_MAX_TOOL_ROUNDS=25
VITE_AGENT_TEMPERATURE=0.3
VITE_AGENT_MAX_TOKENS=16384
VITE_CONTEXT_COMPACTION_WINDOW=10
VITE_AGENT_REFLECTION_THRESHOLD=3

# ════════════════════════════════════════
# UI 默认参数（仅影响前端显示，实际模型/密钥由后端管理）
# ════════════════════════════════════════
VITE_POLL_INTERVAL=5000
